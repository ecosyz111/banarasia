# ---------------------------------------------------------------------------
# ADMIN_TOKEN — gates every write API under /api/caterer (src/lib/admin/auth.ts)
# and is the password for /admin/login.
#
# FAIL-CLOSED: when unset in production the admin APIs return 503, not 200.
# In development an unset token allows any value through with a console warning.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=""

# ---------------------------------------------------------------------------
# STORAGE — where CMS content and uploaded images are kept. There is nothing to
# set by hand: connecting a Vercel Blob store to the project injects the
# variables, and their presence is the switch (src/lib/caterer/blob.ts).
#
# Connecting a store sets BLOB_STORE_ID and a rotating VERCEL_OIDC_TOKEN — the
# default — or a long-lived BLOB_READ_WRITE_TOKEN. Either turns on the Blob
# backend; the SDK works out which credential to use on its own.
#
# WITH A STORE ATTACHED:
#   caterer/…         all CMS content, one JSON file per record
#   caterer/uploads/  uploaded images
#   Required on Vercel and any other serverless host. Create the store with
#   PRIVATE access — a store's access mode is fixed at creation and covers
#   everything in it, and these shards include captured leads. Images are
#   private too as a result, and are served through
#   src/app/uploads/caterer/[filename] instead of by blob URL.
#   Vercel dashboard → Storage → Create → Blob → Private, then connect it to
#   the project; Vercel injects this variable into every deployment, and
#   `vercel env pull` brings the variables down for local work against it.
#
# WITH NO STORE (local disk):
#   data/caterer/            all CMS content, one JSON file per record
#   public/uploads/caterer/  uploaded images
#   The default for local development, and correct for a VPS or a container
#   with those two paths on a mounted volume. NOT usable on serverless: there
#   /var/task is read-only, so uploads fail, and the store falls back to a
#   per-instance /tmp that is wiped on the next cold start — admin edits appear
#   to save and then disappear.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"   # only for code running off Vercel

# ---------------------------------------------------------------------------
# DATABASE_URL / DIRECT_URL — OPTIONAL, and currently unused at runtime.
#
# The Prisma models in prisma/schema.prisma are inert: the app reads and writes
# only through the JSON store above. Only scripts/seed-caterer.mjs talks to
# Postgres. Leave both unset and the build skips migrations cleanly
# (scripts/migrate-if-configured.mjs no-ops).
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"
