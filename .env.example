# ---------------------------------------------------------------------------
# ADMIN_TOKEN — gates every write API under /api/caterer (src/lib/admin/auth.ts)
# and is the password for /admin/login.
#
# FAIL-CLOSED: when unset in production the admin APIs return 503, not 200.
# In development an unset token allows any value through with a console warning.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=""

# ---------------------------------------------------------------------------
# STORAGE — where CMS content and uploaded images are kept. Three backends, and
# nothing to set by hand: whichever is configured wins, in this order.
#
#   1. POSTGRES  DATABASE_URL set        <- recommended on serverless
#   2. BLOB      a Blob store attached
#   3. DISK      neither                 <- local development
#
# Postgres is first on purpose: a project moved off Blob keeps BLOB_STORE_ID in
# its environment long after the store stopped serving.
#
# Connecting a store sets BLOB_STORE_ID and a rotating VERCEL_OIDC_TOKEN — the
# default — or a long-lived BLOB_READ_WRITE_TOKEN. Either turns on the Blob
# backend; the SDK works out which credential to use on its own.
#
# WITH A STORE ATTACHED:
#   caterer/…         all CMS content, one JSON file per record
#   caterer/uploads/  uploaded images
#   Required on Vercel and any other serverless host. Create the store with
#   PRIVATE access — a store's access mode is fixed at creation and covers
#   everything in it, and these shards include captured leads. Images are
#   private too as a result, and are served through
#   src/app/uploads/caterer/[filename] instead of by blob URL.
#   Vercel dashboard → Storage → Create → Blob → Private, then connect it to
#   the project; Vercel injects this variable into every deployment, and
#   `vercel env pull` brings the variables down for local work against it.
#
# WITH NO STORE (local disk):
#   data/caterer/            all CMS content, one JSON file per record
#   public/uploads/caterer/  uploaded images
#   The default for local development, and correct for a VPS or a container
#   with those two paths on a mounted volume. NOT usable on serverless: there
#   /var/task is read-only, so uploads fail, and the store falls back to a
#   per-instance /tmp that is wiped on the next cold start — admin edits appear
#   to save and then disappear.
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"   # only for code running off Vercel

# ---------------------------------------------------------------------------
# DATABASE_URL — the Postgres backend, and the one to use on Vercel.
#
# WHY IT IS PREFERRED OVER BLOB: Vercel's Hobby plan meters Blob by operations,
# and this store is operation-hungry by design (one object per record, read
# uncached so a save shows up immediately). That exhausted the account's monthly
# Blob allowance in a week; the store was suspended and every content route went
# down with it. The same records as rows cost nothing measurable — the whole
# catalogue is well under a megabyte against a free tier of half a gigabyte.
#
# Connect a Neon (or any) Postgres database to the project and Vercel injects
# this variable. The store creates what it needs on first use:
#
#   caterer_shard   all CMS content, one row per record
#   caterer_upload  uploaded images, bytes and content type
#
# No migration step: the tables are created on demand (src/lib/caterer/pg.ts).
# A pooled connection string is correct here — the pool is capped at one socket
# per instance.
#
# CATERER_PG_SCHEMA — which schema those two tables live in. Defaults to
# caterer_cms. Set it when one database is shared with another site, especially
# another deployment of THIS codebase: both would otherwise want caterer_shard
# in the same schema and would silently serve each other's content. A lowercase
# identifier; anything else is refused rather than interpolated into DDL.
#
# Changing it on a live deployment does not move records — it hides them behind
# an empty store that then seeds itself.
#
# DIRECT_URL and PRISMA_MIGRATE only matter if someone revives the inert models
# in prisma/schema.prisma; nothing at runtime reads them, and the build skips
# `prisma migrate deploy` unless PRISMA_MIGRATE=1.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:6543/postgres?sslmode=require"
# CATERER_PG_SCHEMA="banarasia"   # only when sharing a database
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"
