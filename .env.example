# ---------------------------------------------------------------------------
# ADMIN_TOKEN — gates every write API under /api/caterer (src/lib/admin/auth.ts)
# and is the password for /admin/login.
#
# FAIL-CLOSED: when unset in production the admin APIs return 503, not 200.
# In development an unset token allows any value through with a console warning.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=""

# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN — selects the persistence backend in
# src/lib/caterer/store.ts:
#   set    → Vercel Blob, one JSON file per record under `system/caterer/` (durable)
#   unset  → local files, one JSON per record under data/caterer/ (/tmp on Vercel)
#
# Leave unset for local development. REQUIRED in production: without it the
# store writes to the serverless /tmp and every edit is lost on cold start.
# It also decides where /api/caterer/upload puts images (Blob vs public/uploads).
# ---------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# DATABASE_URL / DIRECT_URL — OPTIONAL, and currently unused at runtime.
#
# The Prisma models in prisma/schema.prisma are inert: the app reads and writes
# only through the JSON/Blob store above. Only scripts/seed-caterer.mjs talks to
# Postgres. Leave both unset and the build skips migrations cleanly
# (scripts/migrate-if-configured.mjs no-ops).
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"
